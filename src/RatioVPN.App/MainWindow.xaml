<Window x:Class="RatioVPN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatioVPN.App"
        xmlns:pages="clr-namespace:RatioVPN.App.Pages"
        Title="Ratio VPN" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Icon="pack://application:,,,/RatioVPN;component/Assets/ratio.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ Seitenleiste ============================ -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,16" LastChildFill="False">

                <!-- Marke -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ratio VPN" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Split-Tunneling · 2.0" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Gesamtstatus -->
                <Border DockPanel.Dock="Top" CornerRadius="12" Padding="12,11" Margin="0,0,0,18"
                        Background="{Binding StatusSoftBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:StatusDot Fill="{Binding StatusBrush}" IsPulsing="{Binding StatusPulsing}" Diameter="9" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusTitle}" Foreground="{Binding StatusBrush}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation -->
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumIs}, ConverterParameter=Cockpit}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}"
                                Visibility="{Binding ProtectedCount, Converter={StaticResource CountToVis}}">
                            <TextBlock Text="{Binding ProtectedCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        </Border>
                        <TextBlock Text="Cockpit" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumIs}, ConverterParameter=Programs}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="Programme" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumIs}, ConverterParameter=Automatik}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="Automatik" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumIs}, ConverterParameter=Tunnels}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                            <Run Text="{Binding ConnectedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Tunnels.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Verbindungen" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumIs}, ConverterParameter=Stats}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="Statistik" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumIs}, ConverterParameter=Settings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="Einstellungen" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- Schnellschalter -->
                <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="12,10" Background="#0DFFFFFF">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Automatik" FontSize="12.5" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AutoPilotEnabled}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Kill-Switch" FontSize="12.5" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding KillSwitch}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================ Inhalt ============================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste (zum Ziehen) mit Fensterknöpfen -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimieren"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximieren"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Schließen"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <!-- Seitenkopf -->
            <StackPanel Grid.Row="1" Margin="30,0,30,14">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Hinweisleiste -->
            <Border Grid.Row="2" Background="{StaticResource DangerSoft}" BorderBrush="#66F05D5E" BorderThickness="1" CornerRadius="10"
                    Padding="14,10" Margin="30,0,30,12" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Danger}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="13" MaxWidth="820"/>
                </StackPanel>
            </Border>

            <!-- Seiten -->
            <Grid Grid.Row="3" Margin="30,0,22,0">
                <pages:CockpitPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Cockpit}"/>
                <pages:ProgramsPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Programs}"/>
                <pages:AutomatikPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Automatik}"/>
                <pages:TunnelsPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Tunnels}"/>
                <pages:StatsPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Stats}"/>
                <pages:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Settings}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
