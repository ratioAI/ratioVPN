<Window x:Class="RatioVPN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatioVPN.App"
        Title="Ratio VPN" Width="900" Height="640" MinWidth="720" MinHeight="480"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Icon="pack://application:,,,/Assets/ratio.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Accent}" VerticalAlignment="Center">
                <TextBlock Text="R" FontSize="22" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Ratio VPN" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Reiter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="TabPrograms" Content="Programme" Style="{StaticResource TabButton}" IsChecked="True" GroupName="tabs"/>
            <RadioButton x:Name="TabTunnels" Content="Verbindungen" Style="{StaticResource TabButton}" GroupName="tabs"/>
            <RadioButton x:Name="TabSettings" Content="Einstellungen" Style="{StaticResource TabButton}" GroupName="tabs"/>
        </StackPanel>

        <!-- Hinweisleiste -->
        <Border Grid.Row="2" Background="#3A1F24" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- ===================== Programme ===================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsChecked, ElementName=TabPrograms, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7"/>
                    <TextBlock Text="⌕" FontSize="16" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button Grid.Column="1" Content="+ Programm hinzufügen" Style="{StaticResource BaseButton}" Margin="10,0,0,0"
                        Click="OnAddProgram" ToolTip="Für Programme ohne Fenster (z. B. Hintergrunddienste)"/>
            </Grid>

            <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Text="Wähle pro Programm, über welche VPN-Verbindung es ins Internet geht. Läuft ein Programm mehrfach als eigener Prozess (z. B. zwei Java-/Minecraft-Fenster), kannst du jedem Fenster darunter eine eigene Verbindung geben. Bestehende Verbindungen des Programms brechen beim Umstellen kurz ab."/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Programs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProgramItem}">
                            <Border Style="{StaticResource Card}" Padding="12,10">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="230"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Surface2}">
                                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" ToolTip="{Binding ExePath}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,1,7,0"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="3" Style="{StaticResource DarkCombo}"
                                              ItemsSource="{Binding Options}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding TunnelId, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Einzelne Fenster (eigene Prozesse), z. B. zwei Java-/Minecraft-Instanzen -->
                                <ItemsControl ItemsSource="{Binding Windows}" Margin="0,8,0,0"
                                              Visibility="{Binding HasWindows, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:WindowItem}">
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="48,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="230"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0">
                                                            <Run Text="Eigenes Fenster · Prozess"/> <Run Text="{Binding Pid, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,1,7,0"/>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="2" Style="{StaticResource DarkCombo}" Margin="0,0,0,2"
                                                              ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding Value, Mode=TwoWay}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Verbindungen ===================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsChecked, ElementName=TabTunnels, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="+ WireGuard-Dateien importieren" Style="{StaticResource PrimaryButton}" Click="OnImport"/>
                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Text="oder .conf-Dateien einfach ins Fenster ziehen"/>
            </Grid>

            <!-- Leerer Zustand -->
            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20,18"
                    Visibility="{Binding HasNoTunnels, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="So bekommst du deine VPN-Verbindungen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="{StaticResource Muted}">
                        <Run Text="1.  Bei deinem VPN-Anbieter anmelden (z. B. Proton VPN Plus: account.protonvpn.com)."/>
                        <LineBreak/>
                        <Run Text="2.  Unter „Downloads → WireGuard-Konfiguration“ Plattform „Windows“ wählen und pro Server eine Datei herunterladen."/>
                        <LineBreak/>
                        <Run Text="3.  Für 10 verschiedene IP-Adressen: 10 Dateien mit verschiedenen Servern erzeugen."/>
                        <LineBreak/>
                        <Run Text="4.  Alle .conf-Dateien hier importieren und unter „Programme“ zuweisen."/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Funktioniert mit jeder WireGuard-Datei: Proton, Mullvad, Surfshark, AirVPN oder ein eigener Server."/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tunnels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TunnelItem}">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <TextBox Style="{StaticResource InlineEdit}" MinWidth="120" MaxWidth="360"
                                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="IP prüfen" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.CheckIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding ToggleText}" Style="{StaticResource BaseButton}" Margin="0,0,8,0" MinWidth="96"
                                                Command="{Binding DataContext.ToggleTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Entfernen" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.RemoveTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="22,4,0,0">
                                        <Run Text="{Binding Endpoint, Mode=OneWay}"/><Run Text="  ·  Tunnel-IP "/><Run Text="{Binding Address, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" Margin="22,4,0,0">
                                        <Run Text="{Binding Details, Mode=OneWay}"/><Run Text="     "/><Run Text="{Binding Traffic, Mode=OneWay}"/><Run Text="     "/><Run Text="{Binding PublicIp, Mode=OneWay}" Foreground="{StaticResource Text}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" Margin="22,4,0,0"
                                               TextWrapping="Wrap" Text="{Binding Programs}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Einstellungen ===================== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=TabSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Kill-Switch" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Ist eine Verbindung getrennt, bekommen die zugewiesenen Programme gar kein Internet – statt unbemerkt mit deiner echten IP online zu gehen."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding KillSwitch}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Mit Windows starten" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Startet Ratio VPN beim Anmelden minimiert im Infobereich (über die Aufgabenplanung, daher ohne UAC-Abfrage)."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Autostart}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Beim Schließen im Infobereich weiterlaufen" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Das X schließt nur das Fenster. Beenden über Rechtsklick auf das Symbol neben der Uhr."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gut zu wissen" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" FontSize="12.5">
                            <Run Text="• DNS-Anfragen laufen in Windows über einen Systemdienst und damit nicht durch den Tunnel. Im Browser „Sicheres DNS“ (DNS über HTTPS) einschalten, dann gehen auch die Namensauflösungen durch das VPN."/>
                            <LineBreak/>
                            <Run Text="• IPv6 wird für zugewiesene Programme blockiert, damit sie über IPv4 durch den Tunnel gehen und deine echte Adresse nicht durchsickert."/>
                            <LineBreak/>
                            <Run Text="• Ziele im Heimnetz (Router, Drucker, NAS) erreichen zugewiesene Programme weiterhin direkt."/>
                            <LineBreak/>
                            <Run Text="• Die WireGuard-Schlüssel werden mit deinem Windows-Konto verschlüsselt gespeichert (%APPDATA%\RatioVPN)."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource MutedText}" Margin="4,6,0,0" Text="Ratio VPN 1.0 · WireGuard® ist eine eingetragene Marke von Jason A. Donenfeld · Paketumleitung: WinDivert (LGPL)"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
