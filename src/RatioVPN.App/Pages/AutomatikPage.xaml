<UserControl x:Class="RatioVPN.App.Pages.AutomatikPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RatioVPN.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,18">

            <!-- ============ Hauptschalter ============ -->
            <Border CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface}">
                <Grid>
                    <Border CornerRadius="16" Background="{StaticResource HeroGradient}"/>
                    <Grid Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentGradient}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0">
                            <TextBlock Text="Automatik für unbeaufsichtigten Betrieb" Style="{StaticResource H2}" FontSize="16"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5" LineHeight="18"
                                       Text="Jedes Programm, das zu einer Regel passt, bekommt automatisch eine Verbindung – nie doppelt belegt. Fällt eine aus, wechselt es auf eine freie Reserve (unzuverlässige Server zuletzt). Ist keine frei oder das Internet weg, wird blockiert statt mit deiner echten IP zu verbinden."/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Top" IsChecked="{Binding AutoPilotEnabled}"/>
                        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="16,14,0,0">
                            <TextBlock Text="Eine Verbindung gilt als ausgefallen nach" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="56" Margin="8,0" Padding="6,4" HorizontalContentAlignment="Center"
                                     Text="{Binding FailAfterSeconds, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Sekunden ohne Antwort (10–300)" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ Regeln ============ -->
            <Grid Margin="0,4,0,0">
                <TextBlock Text="REGELN" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <ComboBox Style="{StaticResource DarkCombo}" Width="220" Height="32"
                              ItemsSource="{Binding Rules.RunningExes}" SelectedItem="{Binding Rules.SelectedRunningExe, Mode=TwoWay}"
                              ToolTip="Legt eine Regel für ein gerade geöffnetes Programm an">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkCombo}"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <Button Style="{StaticResource BaseButton}" Margin="8,0,0,0" Padding="12,6" Command="{Binding Rules.AddRuleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="{StaticResource Text}" Margin="0,0,8,0"/>
                            <TextBlock Text="Neue Regel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="Aus laufendem Programm …" Style="{StaticResource MutedText}" IsHitTestVisible="False"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,16"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Rules.Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RuleItem}">
                        <Border Style="{StaticResource CardHover}" Padding="18,14">
                            <StackPanel>
                                <!-- Kopf -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InlineEdit}" HorizontalAlignment="Left" MinWidth="160" MaxWidth="360"
                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"/>
                                    <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource Text}"/>
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="7,5" ToolTip="Nach oben (hat dann Vorrang)"
                                                Command="{Binding DataContext.Rules.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="7,5" ToolTip="Nach unten"
                                                Command="{Binding DataContext.Rules.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Padding="7,5" ToolTip="Regel löschen"
                                                Command="{Binding DataContext.Rules.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Erkennung -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PROGRAMMDATEIEN" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding ExeNames, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Kommagetrennt, z. B. javaw.exe, java.exe – leer = jedes Programm"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FENSTERTITEL (REGULÄRER AUSDRUCK)" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding TitlePattern, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="{Binding PatternError}" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,4,0,0"
                                                   Visibility="{Binding PatternError, Converter={StaticResource EmptyToCollapsed}}"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Leer = Programm auch ohne Fenster erkennen (Skripte, Bots, Dienste)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Verhalten -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="8" Background="#0F1219" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Entry.Id}" Content="Jede Kopie eigene Verbindung"
                                                         IsChecked="{Binding Mode, Converter={StaticResource EnumIs}, ConverterParameter=Separate}"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Entry.Id}" Content="Alle Kopien eine Verbindung"
                                                         IsChecked="{Binding Mode, Converter={StaticResource EnumIs}, ConverterParameter=Shared}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="Kick-Erkennung" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"
                                               ToolTip="Meldet, wenn eine Kopie 60 s lang keinen Verkehr mehr hat (z. B. vom Server gekickt)"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding WatchTraffic}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Live-Treffer -->
                                <Border CornerRadius="8" Padding="10,7" Margin="0,14,0,0" Background="#07FFFFFF">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="matchIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="matchText" Text="{Binding MatchText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasMatches}" Value="True">
                                <Setter TargetName="matchIcon" Property="Foreground" Value="{StaticResource Success}"/>
                                <Setter TargetName="matchText" Property="Foreground" Value="{StaticResource Text}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Discord ============ -->
            <TextBlock Text="BENACHRICHTIGUNG" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="16" Foreground="{StaticResource AccentHover}" Margin="0,0,10,0"/>
                        <TextBlock Text="Discord-Webhook" Style="{StaticResource H2}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12.5"
                               Text="Wichtige Ereignisse (Wechsel, Blockade, Kick, Internet weg, doppelte IP) gebündelt in einen Discord-Kanal schicken."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding DiscordWebhook, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="1" Content="Test senden" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Command="{Binding TestDiscordCommand}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding DiscordStatus}"
                               Visibility="{Binding DiscordStatus, Converter={StaticResource EmptyToCollapsed}}"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5"
                               Text="Discord: Servereinstellungen → Integrationen → Webhooks → Neuer Webhook → Kanal wählen → „Webhook-URL kopieren“."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
