<UserControl x:Class="RatioVPN.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,16" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top" Foreground="{StaticResource AccentHover}"/>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Kill-Switch" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12.5"
                                   Text="Ist eine Verbindung getrennt, bekommen die zugewiesenen Programme gar kein Internet – statt unbemerkt mit deiner echten IP online zu gehen."/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding KillSwitch}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top" Foreground="{StaticResource AccentHover}"/>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Mit Windows starten" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12.5"
                                   Text="Startet Ratio VPN beim Anmelden minimiert im Infobereich (über die Aufgabenplanung, daher ohne UAC-Abfrage). Nach einem Update zeigt der Autostart automatisch auf die neue Version."/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Autostart}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE737;" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top" Foreground="{StaticResource AccentHover}"/>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Beim Schließen im Infobereich weiterlaufen" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12.5"
                                   Text="Das X schließt nur das Fenster. Beenden über Rechtsklick auf das Symbol neben der Uhr."/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" Margin="0,0,10,0" Foreground="{StaticResource AccentHover}"/>
                        <TextBlock Text="Gut zu wissen" Style="{StaticResource H2}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" FontSize="12.5">
                        <Run Text="• DNS-Anfragen laufen in Windows über einen Systemdienst und damit nicht durch den Tunnel. Im Browser „Sicheres DNS“ (DNS über HTTPS) einschalten, dann gehen auch die Namensauflösungen durch das VPN."/>
                        <LineBreak/>
                        <Run Text="• IPv6 wird für zugewiesene Programme blockiert, damit sie über IPv4 durch den Tunnel gehen und deine echte Adresse nicht durchsickert."/>
                        <LineBreak/>
                        <Run Text="• Ziele im Heimnetz (Router, Drucker, NAS) erreichen zugewiesene Programme weiterhin direkt."/>
                        <LineBreak/>
                        <Run Text="• Ohne Regeln leitet Ratio VPN gar nichts um – dann läuft der PC mit voller Geschwindigkeit."/>
                        <LineBreak/>
                        <Run Text="• Die WireGuard-Schlüssel werden mit deinem Windows-Konto verschlüsselt gespeichert (%APPDATA%\RatioVPN)."/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource MutedText}" Margin="4,6,0,0" TextWrapping="Wrap"
                       Text="Ratio VPN 2.0 · WireGuard® ist eine eingetragene Marke von Jason A. Donenfeld · Paketumleitung: WinDivert (LGPL)"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
