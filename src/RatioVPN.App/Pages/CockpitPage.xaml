<UserControl x:Class="RatioVPN.App.Pages.CockpitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Übergang: Verlauf; Kacheln folgen (Task 16). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Verlauf der Automatik" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
