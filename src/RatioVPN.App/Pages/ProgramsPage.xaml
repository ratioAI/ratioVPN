<UserControl x:Class="RatioVPN.App.Pages.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RatioVPN.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Margin="0,0,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,8,8"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="13,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Programm oder Fenster suchen …" Style="{StaticResource MutedText}" FontSize="13" Margin="35,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Search, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=inverse}"/>
            </Grid>
            <Button Grid.Column="1" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Click="OnAddProgram"
                    ToolTip="Für Programme ohne Fenster (z. B. Hintergrunddienste, Skripte)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="{StaticResource Text}" Margin="0,0,8,0"/>
                    <TextBlock Text="Programm hinzufügen"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,8,12" FontSize="12.5"
                   Text="Läuft ein Programm mehrfach als eigener Prozess (z. B. mehrere Minecraft-Fenster), kannst du jedem Fenster darunter eine eigene Verbindung geben. Bestehende Verbindungen eines Programms brechen beim Umstellen kurz ab."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Programs}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProgramItem}">
                        <Border Style="{StaticResource CardHover}" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="230"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Surface2}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" HorizontalAlignment="Center" Foreground="{StaticResource Faint}"/>
                                            <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" ToolTip="{Binding ExePath}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="8" Padding="9,4" Margin="0,0,12,0" VerticalAlignment="Center" Background="#0AFFFFFF">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,1,7,0"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Grid.Column="3" Style="{StaticResource DarkCombo}"
                                              ItemsSource="{Binding Options}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding TunnelId, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Einzelne Prozesse (z. B. mehrere Minecraft-Fenster) -->
                                <ItemsControl ItemsSource="{Binding Windows}" Margin="0,10,0,0"
                                              Visibility="{Binding HasWindows, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:WindowItem}">
                                            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="50,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="230"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,1,0,0">
                                                            <Run Text="Eigener Prozess"/> <Run Text="{Binding Pid, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="8" Padding="9,4" Margin="0,0,12,0" VerticalAlignment="Center" Background="#0AFFFFFF">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,1,7,0"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ComboBox Grid.Column="2" Style="{StaticResource DarkCombo}" Margin="0,0,0,2"
                                                              ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding Value, Mode=TwoWay}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
